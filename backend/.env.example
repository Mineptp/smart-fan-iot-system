# ==========================================
# Backend Environment Configuration Pattern
# ==========================================

# Eclipse Mosquitto MQTT Broker Configuration
# Local Mosquitto default: mqtt://localhost:1883
# Public test Mosquitto: mqtt://test.mosquitto.org:1883
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC_TELEMETRY=smartfan/telemetry
MQTT_TOPIC_DOWNLINK=smartfan/control

# Supabase Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_TABLE=fan_telemetry
